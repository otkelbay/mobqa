# Signs access and refresh tokens; at least 32 characters. Generate: openssl rand -hex 32
MOBQA_TOKEN_SECRET=
# Seals environment secrets; 32 bytes in base64. Generate: openssl rand -base64 32
MOBQA_SECRET_KEY=
# OpenRouter or any OpenAI-compatible provider; generation, authoring and knowledge need it.
MOBQA_LLM_API_KEY=
